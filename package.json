{
  "name": "solidity-workbench",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "hardhat run scripts/sync-networks.ts && vite",
    "build": "hardhat run scripts/sync-networks.ts && tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:ci": "vitest run",
    "preview": "vite preview",
    "deploy": "node scripts/deploy-runner.ts",
    "grab": "hardhat run scripts/sync-networks.ts && npx tsx scripts/grab-contract.ts",
    "ungrab": "hardhat run scripts/sync-networks.ts && npx tsx scripts/remove-grabbed-contract.ts",
    "verify": "npx tsx scripts/verify-contract.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "lucide-react": "^1.7.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@chainlink/contracts": "1.2.0",
    "@eslint/js": "^9.39.4",
    "@nomicfoundation/hardhat-ignition": "^3.1.0",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.3",
    "@nomicfoundation/hardhat-verify": "^3.0.12",
    "@openzeppelin/contracts": "^5.6.1",
    "@rolldown/plugin-babel": "^0.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "hardhat": "^3.2.0",
    "jsdom": "^30.0.1",
    "modules": "link:@nomicfoundation/hardhat-ignition/modules",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.10"
  }
}
